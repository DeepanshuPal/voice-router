# STT providers (any subset works - missing keys just remove that provider from rotation)
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# TTS providers
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=

# LLM leg (optional - pip install voice-router[llm])
ANTHROPIC_API_KEY=

# Router settings
ROUTER_CONFIG=config/providers.yaml
ROUTER_DEFAULT_STRATEGY=benchmark
TELEMETRY_PATH=.telemetry/calls.jsonl
